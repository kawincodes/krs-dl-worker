{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krs-dl-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The React UI (web/) is built by Vite and served as static assets.
  // Only API and file routes reach the Worker code.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/files/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "krs-dl"
    }
  ],
  "vars": {
    // Largest file (in bytes) the worker will accept: 50 GiB.
    "MAX_FILE_BYTES": "53687091200",
    // "true" lets anyone with a /files/<key> link download it.
    // "false" requires the API token for downloads too.
    "PUBLIC_DOWNLOADS": "true"
  }
  // Secret, set with `npx wrangler secret put API_TOKEN`:
  //   API_TOKEN - bearer token required to save, list and delete files.
}
